<Project Sdk="Microsoft.NET.Sdk">

  <!-- Everything the SDK does for you lives in here: finding the game, referencing its assemblies and
       Harmony, generating your mod's entry point, building the AshForge adapter, and packaging the mod so it
       works from the game's own Mods folder AND through the AshForge Hub. Keep this import first. -->
  <Import Project="..\..\build\AshForge.Mod.props" />

  <PropertyGroup>
    <!-- Your mod's identity (id, name, version, author) lives in mod.json. The folder the game knows your
         mod by is this project's name; keep it the same from release to release. -->
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>

    <!-- Uncomment if the SDK can't find your install (point at the folder containing aoa.exe):
    <AshForgeGameDir>D:\Games\Ascent of Ashes</AshForgeGameDir>
    -->

    <!-- Uncomment to build without copying the mod into the game's Mods folder:
    <AshForgeDeploy>false</AshForgeDeploy>
    -->
  </PropertyGroup>

</Project>
